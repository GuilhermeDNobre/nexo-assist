# PostgreSQL connection used by the application (docker-compose default).
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo

# PostgreSQL connection used by integration tests and Playwright.
DATABASE_URL_TEST=postgresql://nexo:nexo@localhost:5432/nexo_test

# Secret used to sign session JWTs. Must be at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-value

# Bearer token required by the simulated legacy ticket service.
LEGACY_API_TOKEN=replace-with-a-local-legacy-token

# Public base URL of the application.
APP_BASE_URL=http://localhost:3000

# DeepSeek API key. Optional: routes that need the LLM validate it on use.
DEEPSEEK_API_KEY=

# Model identifier used by the Mastra agent.
AGENT_MODEL=deepseek/deepseek-flash

# TypeSafe/Jev API key. Optional: without it the LLM fallback classifier is used.
TYPESAFE_API_KEY=

# Simulated legacy outage window, in seconds. Zero disables it.
LEGACY_OUTAGE_EVERY_S=0

# Duration of each simulated legacy outage, in seconds.
LEGACY_OUTAGE_DURATION_S=0

# Probability of a simulated legacy outage per request (0 to 1).
LEGACY_OUTAGE_RATE=0

# Global daily budget cap in US dollars.
DAILY_BUDGET_USD=5

# Maximum employee messages sent to the agent per day.
DAILY_MESSAGE_LIMIT=30

# Polling interval used by the chat and analyst console, in milliseconds.
NEXT_PUBLIC_POLL_INTERVAL_MS=3000
